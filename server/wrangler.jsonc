// Only used for local testing (`npm run dev`) and the optional command-line deploy.
// The normal setup is the Cloudflare dashboard — see README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinora-api",
  "main": "worker.js",
  "compatibility_date": "2026-09-20",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kinora",
      // From `npx wrangler d1 create kinora` (only for command-line deploys).
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
